# Counterstep runs without credentials in deterministic no-execution mode.
# Set these only on the server. Never prefix either key with NEXT_PUBLIC_.
COUNTERSTEP_AGENT_MODE=gemini
COUNTERSTEP_REPOSITORY=memory
COUNTERSTEP_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Firestore uses Application Default Credentials on Cloud Run. Local emulator
# users can set FIRESTORE_EMULATOR_HOST instead of downloading a service key.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)

# Explicitly bounded public-demo controls.
COUNTERSTEP_MAX_DAILY_RUNS=200
COUNTERSTEP_AGENT_TIMEOUT_MS=30000
